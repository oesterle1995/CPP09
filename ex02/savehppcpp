void Pmerge::iterative_dichotomie(std::vector<t_element>& tab, t_element& elem, int low, int high)
{ 
    int range = high - low;
    int mid;
    while(range != 0)
    { 
        mid = low + range/2;
        if(elem.value > tab[mid].value)
            low = mid + 1;
        else
            high = mid;
        lourd++;
        range = high - low;        
    }
    tab.insert(tab.begin() + low, elem);
}

std::vector<size_t> Pmerge::generate_jacob_tab(size_t size)
{
    std::vector<size_t> order;
    size_t J_next;
    size_t J_prev = 1;
    size_t J_curr = 3;
    
    if(size < 1)
        return(order);
    order.push_back(1);
    while(order.size() != size)
    { 
        size_t j = std::min(J_curr, size);
        for(size_t tmp = j; tmp > J_prev; tmp--)
            order.push_back(tmp);
        J_next = J_curr + 2 *J_prev;
        J_prev = J_curr;
        J_curr = J_next;
    }
    for(size_t i = 0; i < order.size(); i++)
        order[i] -= 1;
    return(order);
}

void Pmerge::jacob_insertion(std::vector<t_element>& pending,  std::vector<t_element>& main_chain)
{ 
    std::vector<size_t> order_b = generate_jacob_tab(pending.size()); // 1 3 2 5 4  => 0 2 1 4 3
    size_t high;
    main_chain.insert(main_chain.begin(), pending[0]); 
    for(size_t i = 1; i < order_b.size(); i++)
    {
        high = order_b[i] + i;
        iterative_dichotomie(main_chain, pending[order_b[i]], 0, high);
    }
}


void Pmerge::insertion(std::vector<t_element>& tab, std::vector<t_element> &odd)
{ 
    std::vector<t_element> pending;
    std::vector<t_element> main_chain;

    main_chain = tab;
    for(size_t i = 0; i < main_chain.size(); i++)
    {
            pending.push_back(main_chain[i].losers.back());
            main_chain[i].losers.pop_back();
    }
    if(odd.empty() == false)
        pending.push_back(odd.back());
    jacob_insertion(pending, main_chain);
    tab.swap(main_chain);
}


void Pmerge::new_tab(std::vector<t_element>& tab)
{ 
    std::vector<t_element> new_tab;
    for(size_t i = 0; i < tab.size(); i += 2)
    { 
        if(tab[i].value < tab[i + 1].value)
        { 
            tab[i + 1].losers.push_back(tab[i]);
            new_tab.push_back(tab[i+1]);
        }
        else
        {
            tab[i].losers.push_back(tab[i+1]);
            new_tab.push_back(tab[i]);
        }
        lourd++;
    }
    tab.swap(new_tab);
}


void Pmerge::ford_johnson_algorithm(std::vector<t_element>& tab)
{
    std::vector<t_element> odd;
    if(tab.size() <= 1)
        return;
    if(tab.size() % 2 != 0)
    {
        odd.push_back(tab[tab.size() - 1]);
        tab.pop_back();
    }
    new_tab(tab);
    // debug_ford(tab, "--- 😛 RECURSIVE UP --- ");
    ford_johnson_algorithm(tab);
    insertion(tab, odd);
    // debug_ford(tab, " --- 😛 RECURSIVE DOWN --- ");
}

