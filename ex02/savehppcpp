// #2 DEBUG
void Pmerge::tree_of_element(const std::vector<t_element>& tab, std::string prefix)
{
    std::string new_prefix;
    size_t end = tab.size() - 1;
    if(tab.empty())
        return;
    for(size_t i = 0; i < tab.size(); i++)
    {
        std::cout << prefix;
        if(i != end)
            std::cout << "├── ";
        else
            std::cout << "└── ";
        std::cout << "[Val: " << tab[i].value << "]" << std::endl;
        if(i != end)
            new_prefix = prefix + "│\t";
        else
            new_prefix = prefix + "\t";
        tree_of_element(tab[i].losers, new_prefix);
    }
}

void Pmerge::debug_ford(const std::vector<t_element>& tab, const std::vector<t_element>& pend, std::string& title)
{
